# Secrets
.env
**/.env
*.env
!.env.example
!**/.env.example

# Python
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc

# Node
node_modules/
**/node_modules/

# Build artifacts
build/
**/build/

# Logs
logs/
**/logs/
*.log

# Local databases
*.db
wing-bb/wing_b_local.db

# OS / editor
.DS_Store
**/.DS_Store
.vscode/

# Misc caches
.cache/

# Terraform — local state and provider cache. .terraform.lock.hcl is NOT
# ignored: that file pins provider versions and belongs in git.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/.terraform.tfstate.lock.info

# Ansible — auto-generated by terraform apply (real IP, real key path),
# not something to commit. ansible/inventory.ini.example is the tracked
# reference copy.
ansible/inventory.ini
